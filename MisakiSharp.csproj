<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>disable</Nullable>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>MisakiSharp</PackageId>
        <Version>1.0.0</Version>
        <Authors>Lyrcaxis</Authors>
        <Description>Native C# port of misaki -- Kokoro TTS's official G2P engine. English (spacy-equivalent tokenization, distilled POS tagger, full lexicon) and Chinese (jieba posseg, tone sandhi, pinyin-to-zhuyin) grapheme-to-phoneme conversion, verified at mass scale against the reference implementation.</Description>
        <PackageTags>Misaki, G2P, Phonemes, TTS, Kokoro, NLP, Tokenizer, POSTagger, jieba, pinyin, Chinese, English</PackageTags>
        <RepositoryUrl>https://github.com/Lyrcaxis/MisakiSharp</RepositoryUrl>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="data/zh_g2p.tsv.gz" LogicalName="MisakiSharp.zh_g2p.tsv.gz" />
        <EmbeddedResource Include="data/zh_g2p_v2.tsv.gz" LogicalName="MisakiSharp.zh_g2p_v2.tsv.gz" />
        <EmbeddedResource Include="data/zh_posseg_hmm.tsv.gz" LogicalName="MisakiSharp.zh_posseg_hmm.tsv.gz" />
        <EmbeddedResource Include="data/zh_finalseg_hmm.tsv.gz" LogicalName="MisakiSharp.zh_finalseg_hmm.tsv.gz" />
        <EmbeddedResource Include="data/en_lexicon_us.tsv.gz" LogicalName="MisakiSharp.en_lexicon_us.tsv.gz" />
        <EmbeddedResource Include="data/en_lexicon_gb.tsv.gz" LogicalName="MisakiSharp.en_lexicon_gb.tsv.gz" />
        <EmbeddedResource Include="data/en_tokenizer.tsv.gz" LogicalName="MisakiSharp.en_tokenizer.tsv.gz" />
        <EmbeddedResource Include="data/en_tagger.bin.gz" LogicalName="MisakiSharp.en_tagger.bin.gz" WithCulture="false" />
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="Tests/**" />
        <None Remove="Tests/**" />
        <Content Remove="Tests/**" />
    </ItemGroup>

</Project>
