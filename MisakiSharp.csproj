<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>disable</Nullable>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>MisakiSharp</PackageId>
        <Version>2.0.0</Version>
        <Authors>Lyrcaxis</Authors>
        <Description>A phonemizer, that is a Native C# port of misaki, Kokoro's G2P engine. Supports English, Chinese, Japanese, Spanish, French, Hindi, Italian, and Portuguese.</Description>
        <PackageTags>Misaki, G2P, Phonemes, TTS, Kokoro, NLP, Tokenizer, POSTagger, jieba, pinyin, MeCab, unidic, Chinese, English, Japanese, Spanish, French, Hindi, Italian, Portuguese, espeak</PackageTags>
        <RepositoryUrl>https://github.com/Lyrcaxis/MisakiSharp</RepositoryUrl>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="data/zh_g2p.tsv.gz" LogicalName="MisakiSharp.zh_g2p.tsv.gz" />
        <EmbeddedResource Include="data/zh_g2p_v2.tsv.gz" LogicalName="MisakiSharp.zh_g2p_v2.tsv.gz" />
        <EmbeddedResource Include="data/zh_posseg_hmm.tsv.gz" LogicalName="MisakiSharp.zh_posseg_hmm.tsv.gz" />
        <EmbeddedResource Include="data/zh_finalseg_hmm.tsv.gz" LogicalName="MisakiSharp.zh_finalseg_hmm.tsv.gz" />
        <EmbeddedResource Include="data/en_lexicon_us.tsv.gz" LogicalName="MisakiSharp.en_lexicon_us.tsv.gz" />
        <EmbeddedResource Include="data/en_lexicon_gb.tsv.gz" LogicalName="MisakiSharp.en_lexicon_gb.tsv.gz" />
        <EmbeddedResource Include="data/en_tokenizer.tsv.gz" LogicalName="MisakiSharp.en_tokenizer.tsv.gz" />
        <EmbeddedResource Include="data/en_tagger.bin.gz" LogicalName="MisakiSharp.en_tagger.bin.gz" WithCulture="false" />
        <EmbeddedResource Include="data/hi_espeak_lexicon.tsv.gz" LogicalName="MisakiSharp.hi_espeak_lexicon.tsv.gz" />
        <EmbeddedResource Include="data/es_espeak.tsv.gz" LogicalName="MisakiSharp.es_espeak.tsv.gz" />
        <EmbeddedResource Include="data/fr_espeak.tsv.gz" LogicalName="MisakiSharp.fr_espeak.tsv.gz" />
        <EmbeddedResource Include="data/it_espeak.tsv.gz" LogicalName="MisakiSharp.it_espeak.tsv.gz" />
        <EmbeddedResource Include="data/pt_espeak.tsv.gz" LogicalName="MisakiSharp.pt_espeak.tsv.gz" />
        <EmbeddedResource Include="data/hi_espeak.tsv.gz" LogicalName="MisakiSharp.hi_espeak.tsv.gz" />
        <EmbeddedResource Include="data/enus_espeak.tsv.gz" LogicalName="MisakiSharp.enus_espeak.tsv.gz" />
        <EmbeddedResource Include="data/engb_espeak.tsv.gz" LogicalName="MisakiSharp.engb_espeak.tsv.gz" />
        <EmbeddedResource Include="data/ja_words.txt.gz" LogicalName="MisakiSharp.ja_words.txt.gz" />
        <EmbeddedResource Include="data/ja_lexicon.tsv.gz" LogicalName="MisakiSharp.ja_lexicon.tsv.gz" />
        <EmbeddedResource Include="data/ja_char_unk.tsv.gz" LogicalName="MisakiSharp.ja_char_unk.tsv.gz" />
        <EmbeddedResource Include="data/ja_matrix_compact.bin.gz" LogicalName="MisakiSharp.ja_matrix_compact.bin.gz" WithCulture="false" />
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="Tests/**" />
        <None Remove="Tests/**" />
        <Content Remove="Tests/**" />
    </ItemGroup>

</Project>
